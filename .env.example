# Variables à définir dans Vercel (Settings -> Environment Variables).
# Ne commitez jamais un vrai fichier .env.

APP_ENV=production
# Optionnel : sans APP_URL, l'adresse est détectée automatiquement.
# APP_URL=https://cabinet-five-mu.vercel.app

# Chaîne de connexion Neon (console Neon -> Connect)
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Obligatoire en production
MAIL_FROM_ADDRESS=no-reply@votre-domaine.com
ADMIN_CONTACT_EMAIL=admin@votre-domaine.com
# mail() PHP ne fonctionne pas dans un conteneur : utilisez SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
